        "Kernel Boundary Steward",
        "Consumer Migration Reviewer"
      ],
      "sourceLayer": "shared kernel extraction, public APIs, manifests, and future consumer migrations",
      "maySupport": [
        "reusable kernel surface",
        "neutral manifest field",
        "consumer migration candidate",
        "extraction plan",
        "dependency direction evidence"
      ],
      "blockedClaims": [
        "BISECT workflow API",
        "CROP workflow API",
        "ROUTE workflow API",
        "FLETCH workflow API",
        "RPLAN workflow API",
        "RCOUNT workflow API",
        "application workflow in kernel surface",
        "product-specific fixture assumption"
      ],
      "requiredEvidence": [
        "Kernel Boundary Steward review",
        "consumer migration notes",
        "neutral naming",
        "dependency direction check",
        "workspace tests"
      ]
    },
    {
      "entryId": "RLINE-PF-02",
      "requiredOwners": [
        "Kernel Boundary Steward",
        "Consumer Migration Reviewer"
      ],
      "sourceLayer": "algebra candidate wave, shared math surface, downstream planning, and portfolio dependency adoption",
      "maySupport": [
        "candidate consumer list",
        "planning-only algebra sketch",
        "consumer pressure hypothesis",
        "future implementation wave input"
